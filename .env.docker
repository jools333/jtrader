# ----------------------------------------------------------------------------
# Docker / compose overrides. These keys are read BOTH by docker compose (for
# variable substitution) and by Laravel. After scaffolding, this block is
# merged into the project .env.
# ----------------------------------------------------------------------------

# Host user mapping for clean bind-mount permissions (see `make up`)
UID=1000
GID=1000

# Exposed host ports
APP_PORT=8080
DB_PORT=3306
VITE_PORT=5173

# ---- Database (db service) ----
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT_INTERNAL=3306
DB_DATABASE=jtrader
DB_USERNAME=jtrader
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ---- Cache / queue (redis service) ----
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---- Vite (node service) ----
VITE_DEV_SERVER_URL=http://localhost:5173
